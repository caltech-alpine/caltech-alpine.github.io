# =============================================================================
#  Caltech Alpine Club — Apache configuration
# =============================================================================
#  This file is read by Apache, which is what most Caltech shared hosting runs.
#  If the site is ever moved to nginx this file is ignored and the equivalent
#  rules have to be set in the server config instead. Nothing here is required
#  for the site to work; it is error handling, caching and tidiness.
# =============================================================================

DirectoryIndex index.php index.html

# Show our own 404 page rather than the server's.
ErrorDocument 404 /404.php

# Never list the contents of a directory that has no index file.
Options -Indexes

# ------------------------------------------------------------- media types --
# THIS IS NOT COSMETIC, because this file also sends X-Content-Type-Options:
# nosniff further down. With nosniff set, a browser will not guess a type it
# was given wrongly -- it REFUSES the resource. Apache's bundled mime.types
# has carried .webmanifest only since relatively recently and Caltech hosting's
# version is not something this repo controls, so a manifest served as
# application/octet-stream is a live possibility, and the failure is Chrome
# silently declining to use the club's home-screen icon. Declaring the type
# costs nothing and removes the question.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon              .ico
</IfModule>

# ----------------------------------------------------------------- caching --
# CSS and JS carry a ?v= stamp from the file's modification time (see the
# asset() helper), so they can be cached hard without going stale.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 month"
  ExpiresByType image/jpeg          "access plus 1 month"
  ExpiresByType image/png           "access plus 1 month"
  ExpiresByType image/webp          "access plus 1 month"
  # The root icon and the manifest carry NO ?v= stamp -- the clients that ask
  # for them (crawlers, launchers, pin-to-taskbar) request a bare path and
  # cannot be handed a query string. So they get a shorter life than the
  # stamped assets above, long enough to matter and short enough that a
  # redrawn mark reaches a pinned tab this year.
  ExpiresByType image/x-icon        "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 week"
  # Pages themselves must not be cached: they carry live calendar data.
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------- headers --
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# The staging copy must never be indexed - two indexable copies of the same
# site compete with each other in search results, and the wrong one wins about
# half the time. Keyed on the hostname rather than on a separate file, so the
# same committed .htaccess is correct on both servers and nobody has to
# remember to strip a line at the cutover.
<IfModule mod_setenvif.c>
  SetEnvIf Host "(^|\.)staging\." ALPINE_STAGING
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=ALPINE_STAGING
</IfModule>

# ------------------------------------------------------------------- files --
# The cached calendar copy is public data, but there is no reason to serve it.
#
# csv is in the list too. Everything editable lives in data/, whose own
# .htaccess already denies the lot, so this is belt and braces rather than the
# only thing holding -- but a CSV that escapes into the site root one day
# should not become a downloadable list of every officer's email address.
# Nothing in them is secret; the addresses are printed on the About page. A
# file you can download is still a different thing from the same addresses in
# a page. tools/verify_deploy.py checks it from outside, on the real server.
<FilesMatch "\.(cache|ics|log|md|json|csv)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Local configuration may hold a key. It is a .php file so it would never be
# served as source, but deny it explicitly anyway.
<Files "config.local.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
