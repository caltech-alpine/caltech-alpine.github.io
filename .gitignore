# Cached copy of the Google Calendar feed. Regenerated automatically; there is
# no reason to commit it.
/cache/*
!/cache/.gitkeep
!/cache/.htaccess

# Local configuration overrides. This is where a key would live, if the club
# ever needs one. Never commit it.
/includes/config.local.php

# Editors and operating systems
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/
_preview/

# Static build output. Regenerated by tools/build_static.py and published
# by .github/workflows/pages.yml; there is no reason to commit it.
/_site/

# Usage logs and the hashing salt. Generated on the server, never committed.
/logs/*
!/logs/.gitkeep
!/logs/.htaccess

# Your Caltech username, remembered by tools/deploy.sh so it stops asking. A
# preference, not configuration - the next person's is different.
/.deploy-user

# Staging area built by tools/deploy.sh on the way to the server.
/_deploy/

# The ssh daemon's live state: a random token and the pid of a running session,
# plus the pinned host key. Machine-local, and the token is a secret.
/tools/.portal-daemon.json
/tools/.portal-known-host
